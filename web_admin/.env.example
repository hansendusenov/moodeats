# ==============================================================================
# MoodEats Web Admin - CodeIgniter 4 Environment Template
# Copy to .env and fill in real values
# ==============================================================================

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8081'
app.appTimezone = 'Asia/Jakarta'

# === DATABASE (PostgreSQL via Supabase) ===
database.default.hostname = db.your-project.supabase.co
database.default.database = postgres
database.default.username = postgres
database.default.password =
database.default.DBDriver = Postgre
database.default.port = 5432

# === SUPABASE STORAGE (untuk upload banner/menu images) ===
SUPABASE_URL = https://your-project.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY =

# === SESSION ===
app.sessionDriver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
app.sessionSavePath = 'ci_sessions'

# === ENCRYPTION ===
encryption.key =
database.default.charset = utf8
